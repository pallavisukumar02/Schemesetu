# Copy to .env in this folder. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=http://localhost:5173
NODE_ENV=development

# See backend/.env.example for optional host, Twilio and official API settings.

# Authorized status integrations: leave blank unless the scheme authority
# has approved your application and supplied API details. Hosts are comma-separated.
PMEGP_STATUS_API_URL=
PMEGP_STATUS_API_TOKEN=
PMEGP_STATUS_API_ALLOWED_HOSTS=
PMEGP_WEBHOOK_SECRET=
JANSAMARTH_STATUS_API_URL=
JANSAMARTH_STATUS_API_TOKEN=
JANSAMARTH_STATUS_API_ALLOWED_HOSTS=
JANSAMARTH_WEBHOOK_SECRET=
PMSVANIDHI_STATUS_API_URL=
PMSVANIDHI_STATUS_API_TOKEN=
PMSVANIDHI_STATUS_API_ALLOWED_HOSTS=
PMSVANIDHI_WEBHOOK_SECRET=
STATUS_SYNC_INTERVAL_SECONDS=900
