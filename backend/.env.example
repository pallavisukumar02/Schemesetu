PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional Twilio notifications. Core app works without these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, e.g. whatsapp:+14155238886 for a configured Twilio sender/sandbox
TWILIO_WHATSAPP_FROM=
# SMS sender in E.164 format, e.g. +1...
TWILIO_SMS_FROM=

# Optional Level 3: only configure after receiving an authorized official API/webhook contract.
PMEGP_STATUS_API_URL=
PMEGP_WEBHOOK_SECRET=
JANSAMARTH_STATUS_API_URL=
JANSAMARTH_WEBHOOK_SECRET=

# Private host/admin console. Keep these only on the server; never expose them in Vite.
HOST_EMAIL=host@example.com
HOST_PASSWORD=replace-with-a-long-random-password
PUBLIC_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional persistent DB path for production hosting
DB_PATH=
FRONTEND_ORIGIN=
